# ==============================================================================
# Stratify AI - Environment Configuration Template
# Copy this file to .env:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTES:
# 1. NEVER commit your actual .env file or real secrets to Git.
# 2. .env is excluded via .gitignore.
# 3. All passwords below are non-default development credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# PostgreSQL Persistence
# Note: Host port is mapped to 5434 to prevent conflict with local macOS
# PostgreSQL services that may already be bound to port 5432.
# ------------------------------------------------------------------------------
POSTGRES_USER=stratify_admin
POSTGRES_PASSWORD=stratify_dev_secret_change_me
POSTGRES_DB=stratify_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434

# Full Database Connection URL (AsyncPsycopg 3 dialect for SQLAlchemy 2.x)
DATABASE_URL=postgresql+psycopg://stratify_admin:stratify_dev_secret_change_me@127.0.0.1:5434/stratify_db

# ------------------------------------------------------------------------------
# RabbitMQ Message Broker
# AMQP protocol port: 5672
# Web Management Dashboard: 15672 (http://127.0.0.1:15672)
# ------------------------------------------------------------------------------
RABBITMQ_USER=stratify_broker
RABBITMQ_PASSWORD=broker_dev_secret_change_me
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Full AMQP URL for aio-pika / pika
RABBITMQ_URL=amqp://stratify_broker:broker_dev_secret_change_me@127.0.0.1:5672/

# ------------------------------------------------------------------------------
# External Research & Evidence Provider
# Available options: 'mock' (default, offline), 'tavily', 'serper'
# ------------------------------------------------------------------------------
SEARCH_PROVIDER=mock
TAVILY_API_KEY=

# ------------------------------------------------------------------------------
# AI Reasoning & LLM Provider
# Available options: 'mock' (default, offline), 'gemini', 'openai'
# ------------------------------------------------------------------------------
LLM_PROVIDER=mock
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Distributed Worker & Outbox Tuning
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=2
TASK_TIMEOUT_SECONDS=45
MAX_TASK_RETRIES=3
OUTBOX_POLL_INTERVAL_SECONDS=1.0

# ------------------------------------------------------------------------------
# Frontend & API Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
